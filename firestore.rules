rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidVote(data) {
      return data.keys().hasAll(['uid', 'v']) &&
             data.keys().hasOnly(['uid', 'name', 'v', 'updatedAt']) &&
             data.uid is string && data.uid.size() <= 64 &&
             data.v is list && data.v.size() <= 3 &&
             (!('name' in data) || (data.name is string && data.name.size() <= 100)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Admin grants can only be created/removed from the Firebase Console or Admin SDK.
    // A visitor cannot promote their own account.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /catalogOverrides/{gameId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() &&
        isValidId(gameId) &&
        (request.resource == null || (
          request.resource.data.keys().hasOnly(['deleted', 'game', 'updatedAt']) &&
          request.resource.data.deleted is bool
        ));
    }

    // Public community co-op votes collection
    match /votes/{voteUid} {
      allow read: if true;
      allow create, update: if isValidId(voteUid) && isValidVote(request.resource.data) && request.resource.data.uid == voteUid;
      allow delete: if isValidId(voteUid);
    }
  }
}
